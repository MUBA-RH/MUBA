{
  "schema_version": 1,
  "engine": "comfyui",
  "output": {
    "width": 1024,
    "height": 576,
    "format": "png"
  },
  "chapters": 4,
  "independent_chapters": true,
  "previous_frame_conditioning": false,
  "approval": "telegram-dev",
  "workflow": "workflow/muba_daily_story_api.json",
  "model": {
    "family": "sdxl",
    "checkpoint_env": "MUBA_COMFY_CHECKPOINT",
    "default_checkpoint": "sd_xl_base_1.0.safetensors"
  },
  "identity": {
    "source": "job.reference_path",
    "prompt_contract": "job.chapters[].prompt"
  }
}
